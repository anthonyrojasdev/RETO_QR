# Configuración SOLO DE DESARROLLO (docker compose local y pruebas E2E del CI).
# Estos valores son públicos a propósito: nunca los uses en un servidor.
# Para producción usa .env.prod.example, que genera secretos propios.
#
#   cp .env.example .env
#
# JWT_SECRET y REDIS_PASSWORD solo admiten letras, números, "-" y "_".

# Clave HS256 compartida entre la Auth API (firma) y Kong (verifica). Mínimo 32 caracteres.
JWT_SECRET=dev-jwt-secret-cambiar-en-produccion-0123456789

# Usuarios iniciales (usuario:clave:rol). Se guardan en PostgreSQL con bcrypt al primer arranque.
# Roles: admin (QR + Stats API directa) y analyst (solo QR).
AUTH_USERS=admin:Admin123!:admin,analyst:Analyst123!:analyst

# PostgreSQL: superusuario y un usuario por servicio.
POSTGRES_PASSWORD=dev-postgres-password
AUTH_DB_PASSWORD=dev-auth-db-password
QR_DB_PASSWORD=dev-qr-db-password

# Redis (caché de la QR API y contadores de rate limiting de Kong).
REDIS_PASSWORD=dev-redis-password

# Origen del frontend permitido por CORS y URL pública de Kong que usa el frontend.
CORS_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
