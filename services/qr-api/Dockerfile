# syntax=docker/dockerfile:1

# --- Compilación: binario estático sin CGO ---
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/qr-api ./cmd/server

# --- Ejecución: imagen mínima sin shell y con usuario sin privilegios ---
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/qr-api /qr-api
ENV PORT=8080
EXPOSE 8080
USER nonroot:nonroot
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 CMD ["/qr-api", "healthcheck"]
ENTRYPOINT ["/qr-api"]
