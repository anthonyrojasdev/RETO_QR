# Plantilla de PRODUCCIÓN para el VPS. En el servidor: cp .env.prod.example .env
# Cambia TODOS los valores marcados con CAMBIAR. Genera cada secreto con:
#   openssl rand -hex 32
# JWT_SECRET y REDIS_PASSWORD solo admiten letras, números, "-" y "_" (hex sirve).

# --- Dominio -------------------------------------------------------------------------
# Sin dominio propio, sslip.io resuelve <IP con guiones>.sslip.io a tu IP y Let's Encrypt emite certificado.
DOMAIN=169-58-188-130.sslip.io
PUBLIC_API_URL=https://169-58-188-130.sslip.io
CORS_ORIGIN=https://169-58-188-130.sslip.io

# --- Imágenes ------------------------------------------------------------------------
# Usuario u organización de GitHub dueño de los paquetes (en minúsculas).
GHCR_OWNER=anthonyrojasdev

# --- Secretos (CAMBIAR todos) --------------------------------------------------------
JWT_SECRET=CAMBIAR
REDIS_PASSWORD=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR
AUTH_DB_PASSWORD=CAMBIAR
QR_DB_PASSWORD=CAMBIAR

# Usuarios iniciales (usuario:clave:rol). Solo se crean al primer arranque; usa claves fuertes.
# Las claves no pueden contener comas ni dos puntos.
AUTH_USERS=admin:CAMBIAR:admin,analyst:CAMBIAR:analyst
