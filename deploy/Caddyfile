# Caddy obtiene y renueva solo el certificado HTTPS de {$DOMAIN} (Let's Encrypt).
# Requiere que el dominio apunte a la IP del VPS y que los puertos 80 y 443 estén abiertos.
{$DOMAIN} {
	encode gzip

	# API (login, QR, historial, docs) → Kong
	handle /api/* {
		reverse_proxy kong:8000
	}

	# Todo lo demás → frontend (nginx)
	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
